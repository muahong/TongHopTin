tatic.vnncdn.net/media.api-sports.io/football/teams/45.png?width=0&amp;s=5-SiDDT8_TAmBc8IqyFWCw\"/></picture> Everton </a></td>\n</tr>\n<tr>\n<td>11/10/2026 22:30:00</td>\n<td><a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/40.png?width=0&amp;s=B93mfKXOif2u3xjhGNIjuA\"/></picture>Liverpool </a> 0 - 3 <a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/50.png?width=0&amp;s=88S2Zr4gGd3lmtwJjiRm5w\"/></picture> Manchester City </a></td>\n</tr>\n</tbody>\n</table>\n</div>\n<div>\n\n<div>\n<div>\n<div>\n<div>\n<div>\n\n<span>12/10/2026 | 00:28</span>\n</div>\n<h3>\r\n                                        Kết thúc\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HUXcW6BXQAE0GTq.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/12/huxcw6bxqae0gtq-83.jpg?width=0&amp;s=Ws_r59XnTAhPyTf1UiV9vg\"/></picture>\n<figcaption>Man City tận dụng triệt để ưu thế hơn người để giành chiến thắng 3-0 - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>12/10/2026 | 00:15</span>\n</div>\n<h3>\r\n                                        85'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Liverpool được hưởng quả đá phạt có góc sút rộng, Mac Allister bước lên cứa lòng chân phải chưa đủ độ khó để khuất phục Donnarumma.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>12/10/2026 | 00:07</span>\n</div>\n<h3>\r\n                                        78'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p><strong>Bàn thắng (3-0, Cherki): </strong>Man City phối hợp cực hay trong vòng cấm chủ nhà. Cherki thoát xuống dùng động tác giả loại bỏ Frimpong rồi kết thúc chân phải nâng tỷ số lên 3-0.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2299178284 (1).jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/12/resources-premierleague-pulselive-com-2299178284-1-56.jpg?width=0&amp;s=P4M8_14IILhgJ37VjjZ1aA\"/></picture>\n<figcaption>Cherki dễ dàng xé lưới Alisson - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>12/10/2026 | 00:02</span>\n</div>\n<h3>\r\n                                        74'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Man City đang thi đấu cực kỳ hưng phấn. Gvardiol đá nối chân trái bóng bay qua xà.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:57</span>\n</div>\n<h3>\r\n                                        68'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p><strong>Bàn thắng (2-0, Jeremy Doku): </strong>Tiền vệ người Bỉ đột phá sở trường bên cánh rồi rẽ vào trung lộ cứa lòng tuyệt đỉnh ghi bàn thứ 2 cho Man City.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2299178284.jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/12/resources-premierleague-pulselive-com-2299178284-54.jpg?width=0&amp;s=fQDwZ4OW1VJbwQbuvZ2sVA\"/></picture>\n<figcaption></figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2299178284 (2).jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/12/resources-premierleague-pulselive-com-2299178284-2-55.jpg?width=0&amp;s=UVxcGm81lkwJ_PFz1wrjfw\"/></picture>\n<figcaption>Doku ghi bàn đẹp mắt - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:53</span>\n</div>\n<h3>\r\n                                        65'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p><strong>Bàn thắng (0-1, Haaland):</strong> Sau pha solo rồi dứt điểm bóng bật ra của Doku, Haaland chớp thời cơ nhanh sút chân trái hiểm hóc mở tỷ số.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2026 10 11T165316Z_756797438_UP1EMAB1AWQUS_RTRMADP_3_SOCCER ENGLAND LIV MCI.jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/12/resources-premierleague-pulselive-com-2026-10-11t165316z-756797438-up1emab1awqus-rtrmadp-3-soccer-england-liv-mci-1.jpg?width=0&amp;s=Fd_5q-X83gyd6rISTQPtUw\"/></picture>\n<figcaption>Haaland ăn mừng bàn thắng - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:52</span>\n</div>\n<h3>\r\n                                        62'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p><strong>Thẻ đỏ (Ryan Gravenberch):</strong> Tiền vệ người Hà Lan phạm lỗi với Doku nhận thẻ vàng thứ hai, đồng nghĩa với tấm thẻ đỏ rời sân sớm.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2026 10 11T165316Z_756797438_UP1EMAB1AWQUS_RTRMADP_3_SOCCER ENGLAND LIV MCI (1).jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/12/resources-premierleague-pulselive-com-2026-10-11t165316z-756797438-up1emab1awqus-rtrmadp-3-soccer-england-liv-mci-1-2.jpg?width=0&amp;s=hoO0Lc5YPSnAd02rTAjS6A\"/></picture>\n<figcaption>Gravenberch bị truất quyền thi đấu - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:48</span>\n</div>\n<h3>\r\n                                        60'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Đồng đội trao cơ hội tốt cho Haaland băng xuống sút chân phải, bóng từ từ lăn ra ngoài khá đáng tiếc.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:43</span>\n</div>\n<h3>\r\n                                        54'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Liverpool đang tấn công ấn tượng. Florian Writz nhận bóng đầu vòng cấm rồi quăng chân sút ngay, bóng bay ra ngoài.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2299172352.jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/11/resources-premierleague-pulselive-com-2299172352-2479.jpg?width=0&amp;s=ztaNI7CK66QxgCMP2l1-UQ\"/></picture>\n<figcaption>Donnarumma liên tục cứu thua - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:38</span>\n</div>\n<h3>\r\n                                        48'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Hết Koumas đến Gravenberch nã đại bác sấm sét buộc Donnarumma phải bay người cứu thua.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:18</span>\n</div>\n<h3>\r\n                                        Kết thúc hiệp 1\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HUXM847WYAIgUqL.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/11/huxm847wyaiguql-2450.jpg?width=0&amp;s=66IxTOV0jDb5uVC_qmBnqQ\"/></picture>\n<figcaption>45 phút đầu khép lại với tỷ số hòa 0-0 - Ảnh: MCFC</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:09</span>\n</div>\n<h3>\r\n                                        37'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Cherki xử lý ngẫu hứng bên cánh phải nhưng cú đá cuối cùng lại đưa bóng đi cắt ngang khung thành.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 23:02</span>\n</div>\n<h3>\r\n                                        29'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Victor Munoz vừa có pha xử lý táo bạo trong vòng cấm nhưng cú đá lại đi ra mép lưới sau.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2299163704.jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/11/resources-premierleague-pulselive-com-2299163704-2435.jpg?width=0&amp;s=p3Sny-xswce4JAvg9XcEMg\"/></picture>\n<figcaption>Cú dứt điểm của Koumas - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/10/2026 | 22:49</span>\n</div>\n<h3>\r\n                                        18'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Cherki dẫn bóng phản công nhanh cho Man City. Tiếc rằng, pha phối hợp cuối cùng với Enzo F