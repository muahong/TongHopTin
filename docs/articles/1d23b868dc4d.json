{"content_html": "<html><body><div> <figure> <img alt=\"ndo_br_19b5fc4ca2d5238b7ac4.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e1080369ecc870667702ec0af00a52b9f31c01b55874e0d3fdee123a4d40913cab5/ndo_br_19b5fc4ca2d5238b7ac4.jpg.avif\" title=\"Đội hình xuất phát của đội tuyển Việt Nam trước cuộc tiếp đón Campuchia ở lượt trận cuối bảng A - ASEAN Championship 2026 trên sân vận động quốc gia Mỹ Đình.\"/> <figcaption>Đội hình xuất phát của đội tuyển Việt Nam trước cuộc tiếp đón Campuchia ở lượt trận cuối bảng A - ASEAN Championship 2026 trên sân vận động quốc gia Mỹ Đình.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_d51bb369ecf06dae34e1.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e104141e8474e0b50f9d48d987b45a55cc13ef2e63530a8c163dad85f6425fda9b6/ndo_br_d51bb369ecf06dae34e1.jpg.avif\" title=\"Các cầu thủ hai đội thực hiện nghi thức chào cờ trước khi bước vào trận đấu.\"/> <figcaption>Các cầu thủ hai đội thực hiện nghi thức chào cờ trước khi bước vào trận đấu.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_a9b31e6e46f7c7a99ee6.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10a69afc8d96a7e10de269d6b21a2e748324a9174eb394ff0b50a6706a090a1a25/ndo_br_a9b31e6e46f7c7a99ee6.jpg.avif\" title=\"Đội tuyển Việt Nam nhập cuộc chủ động, đẩy cao đội hình tìm kiếm bàn thắng ngay sau tiếng còi khai cuộc.\"/> <figcaption>Đội tuyển Việt Nam nhập cuộc chủ động, đẩy cao đội hình tìm kiếm bàn thắng ngay sau tiếng còi khai cuộc.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_0b06ff66a6ff27a17eee.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e1025578be3d25d8ede9003384795f8966a5baece53d43c4dabf2317b2e4f97085e/ndo_br_0b06ff66a6ff27a17eee.jpg.avif\" title=\"Huấn luyện viên Kim Sang Sik liên tục chỉ đạo, điều chỉnh chiến thuật bên ngoài đường biên.\"/> <figcaption>Huấn luyện viên Kim Sang Sik liên tục chỉ đạo, điều chỉnh chiến thuật bên ngoài đường biên.</figcaption>\n</figure>\n<figure> <img alt=\"Tiền đạo Nguyễn Đình Bắc mở tỷ số cho đội tuyển Việt Nam bằng pha dứt điểm chéo góc đẹp mắt ở phút 18.\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10ecd876784171265d614bd609edb1b2b008a41ee37635865ab8b049f6a45b7739/ndo_br_3cf46ad92f40ae1ef751.jpg.avif\" title=\"Tiền đạo Nguyễn Đình Bắc mở tỷ số cho đội tuyển Việt Nam bằng pha dứt điểm chéo góc đẹp mắt ở phút 18.\"/> <figcaption>Tiền đạo Nguyễn Đình Bắc mở tỷ số cho đội tuyển Việt Nam bằng pha dứt điểm chéo góc đẹp mắt ở phút 18.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_b90522f5796cf832a17d.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10fd8d843bccb556aa97e9737a4fe1595d2600c4d9ecd9915ed3e0c78caee01cc2/ndo_br_b90522f5796cf832a17d.jpg.avif\" title=\"Niềm vui của Nguyễn Đình Bắc và các đồng đội sau bàn thắng khai thông thế bế tắc cho đội tuyển Việt Nam.\"/> <figcaption>Niềm vui của Nguyễn Đình Bắc và các đồng đội sau bàn thắng khai thông thế bế tắc cho đội tuyển Việt Nam.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_307642ed3374b22aeb65.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10b1b9caf663bdd756d0dac5cfd0ad5ab1a001ec7d75768ceb6934587271ec181d/ndo_br_307642ed3374b22aeb65.jpg.avif\" title=\"Nguyễn Xuân Son thi đấu năng nổ, tích cực tranh chấp và làm tường cho các đồng đội trên hàng công.\"/> <figcaption>Nguyễn Xuân Son thi đấu năng nổ, tích cực tranh chấp và làm tường cho các đồng đội trên hàng công.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_586b68491ad09b8ec2c1.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10e732faef3d884e4b006ee2cd47f04f87c9e9fc7cc6fec7a0cf573f6051d9a772/ndo_br_586b68491ad09b8ec2c1.jpg.avif\" title=\"Xuân Son góp phần vào bàn thắng thứ hai khi cầu thủ đội bạn phản lưới nhà sau cú dứt điểm của tiền đạo này.\"/> <figcaption>Xuân Son góp phần vào bàn thắng thứ hai khi cầu thủ đội bạn phản lưới nhà sau cú dứt điểm của tiền đạo này.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_8d0d2d565fcfde9187de.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10a3a08c300e0a16f7fa28c755d4a1a17b198c5c05fb4f9035e39f5d9125bcdb8d/ndo_br_8d0d2d565fcfde9187de.jpg.avif\" title=\"Khán giả trên sân Mỹ Đình tiếp lửa cho đội tuyển Việt Nam bằng những tràng cổ vũ sôi động và sắc đỏ rực khắp các khán đài.\"/> <figcaption>Khán giả trên sân Mỹ Đình tiếp lửa cho đội tuyển Việt Nam bằng những tràng cổ vũ sôi động và sắc đỏ rực khắp các khán đài.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_1957bce2ce7b4f25166a.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e1069fcd9d30979b713a010953efb1b0940adc66309df89da78c1df8f77be6d8952/ndo_br_1957bce2ce7b4f25166a.jpg.avif\" title=\"Nguyễn Đình Bắc hoàn tất cú đúp, góp công lớn vào chiến thắng 3-1 của đội tuyển Việt Nam.\"/> <figcaption>Nguyễn Đình Bắc hoàn tất cú đúp, góp công lớn vào chiến thắng 3-1 của đội tuyển Việt Nam.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_4eceab8cd815594b0004.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e105642645f20e566217f38188ae80fa70cf655ae652ebe6f541e4f36b7399c4349/ndo_br_4eceab8cd815594b0004.jpg.avif\" title=\"Đội tuyển Campuchia không thể tìm được phương án tấn công về phía khung thành tuyển Việt Nam.\"/> <figcaption>Đội tuyển Campuchia không thể tìm được phương án tấn công về phía khung thành tuyển Việt Nam.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_5dcef11f838602d85b97.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10317a08473c25277d448f5e45b81a0d24ca875608f28ed00b466e99aa6822895e/ndo_br_5dcef11f838602d85b97.jpg.avif\" title=\"Các cầu thủ đội tuyển Việt Nam ăn mừng chiến thắng sau khi tiếng còi mãn cuộc vang lên.\"/> <figcaption>Các cầu thủ đội tuyển Việt Nam ăn mừng chiến thắng sau khi tiếng còi mãn cuộc vang lên.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_eac4714703de8280dbcf.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10b6d77eb6879c170fb0c333a2e1a7b6f0a775251f971e040341d072fdbaff2627/ndo_br_eac4714703de8280dbcf.jpg.avif\" title=\"Người hâm mộ hài lòng với chiến thắng thuyết phục.\"/> <figcaption>Người hâm mộ hài lòng với chiến thắng thuyết phục.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_f583044876d1f78faec0.jpg\" src=\"https://cdn.nhandan.vn/images/1f2ff83b02eb93c501418a70b378d56c58550237990d3dea6aed7f04938d5e10792f7631914e1911d654b669494bc72d12e48f64c477e6d7b26311e8fda59fc6/ndo_br_f583044876d1f78faec0.jpg.avif\" title=\"Chiến thắng trước Campuchia giúp đội tuyển Việt Nam khép lại vòng bảng với ngôi nhất bảng A, qua đó giành quyền vào bán kết ASEAN Championship 2026.\"/> <figcaption>Chiến thắng trước Campuchia giúp đội tuyển Việt Nam khép lại vòng bảng với ngôi nhất bảng A, qua đó giành quyền vào bán kết ASEAN Championship 2026.</figcaption>\n</figure> <div> <p>TRẦN HẢI - PHAN THẠCH</p> </div>  </div></body></html>"}