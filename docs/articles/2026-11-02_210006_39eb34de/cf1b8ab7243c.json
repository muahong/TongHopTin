-sports.io/football/teams/36.png?width=0&amp;s=s_ZRpaGkYQt_6_wOsY8Prg\"/></picture> Fulham </a></td>\n</tr>\n<tr>\n<td>01/11/2026 23:30:00</td>\n<td><a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/40.png?width=0&amp;s=B93mfKXOif2u3xjhGNIjuA\"/></picture>Liverpool </a> 0 - 1 <a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/42.png?width=0&amp;s=_FcjsFh1FiYTOWhEUaDj9A\"/></picture> Arsenal </a></td>\n</tr>\n</tbody>\n</table>\n</div>\n<div>\n\n<div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 01:38</span>\n</div>\n<h3>\r\n                                        Kết thúc\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HWD0RfZWEAA6Xao.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/11/2/hwd0rfzweaa6xao-148.jpg?width=0&amp;s=3uUQulDmNov4Pjb10vV8Kg\"/></picture>\n<figcaption>Chiến thắng nhọc nhằn nhưng xứng đáng của Pháo thủ - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 01:20</span>\n</div>\n<h3>\r\n                                        90'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Ngumoha vừa quăng chân đầu vòng cấm chưa thành công. Hiệp hai có 6 phút bù giờ.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 01:14</span>\n</div>\n<h3>\r\n                                        81'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>HLV Iraola tăng cường hàng công với sự xuất hiện của Ngumoha và Koumas.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 01:10</span>\n</div>\n<h3>\r\n                                        79'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Trận đấu nóng lên sau pha va chạm giữa Mac Allister và Odegaard. Madueke cùng Timber lập tức lao vào bảo vệ đồng đội.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 01:08</span>\n</div>\n<h3>\r\n                                        68'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Arsenal liên tiếp có những pha phản công lợi hại nhưng Odegaard chưa thể tận dụng thành công.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 00:56</span>\n</div>\n<h3>\r\n                                        65'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Barcola bứt tốc bên cánh phải rồi trả ngược cho Writz kết thúc. Tuy nhiên, hậu vệ Arsenal đã che chắn tốt.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2026 11 01T170054Z_805671064_UP1EMB11B9HBB_RTRMADP_3_SOCCER ENGLAND LIV ARS (2).jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/11/2/resources-premierleague-pulselive-com-2026-11-01t170054z-805671064-up1emb11b9hbb-rtrmadp-3-soccer-england-liv-ars-2-45.jpg?width=0&amp;s=JUg9P7EcXnOssRPnKEoBmQ\"/></picture>\n<figcaption>Liverpool cố gắng tìm bàn gỡ</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 00:45</span>\n</div>\n<h3>\r\n                                        53'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Liverpool vẫn đang tìm đường vào cầu môn Raya. Isak xâm nhập vòng cấm sút chân trái căng vọt xà.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 00:21</span>\n</div>\n<h3>\r\n                                        Kết thúc hiệp 1\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HWDj_FXXgAAi1XX.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/11/2/hwdj-fxxgaai1xx-47.jpg?width=0&amp;s=LUECwucV02IklvzDl687UA\"/></picture>\n<figcaption>45 phút đầu khép lại với tỷ số 1-0 nghiêng về Arsenal - Ảnh: AFC</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 00:13</span>\n</div>\n<h3>\r\n                                        43'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Kerkez tạt đẹp vào từ cánh trái cho Mac Allister thoải mái đánh đầu sạt xà, bỏ lỡ cơ hội đáng tiếc.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 00:10</span>\n</div>\n<h3>\r\n                                        39'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Liverpool được hưởng quả đá phạt chếch bên cánh trái. Florian Writz bước lên thực hiện cú cứa lòng dội xà ngang bật ra.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 00:07</span>\n</div>\n<h3>\r\n                                        36'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Liverpool đang miệt mài tấn công tìm bàn gỡ. Isak xoay sở trong vòng cấm rồi dứt điểm chân trái đi sạt cột.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>02/11/2026 | 00:00</span>\n</div>\n<h3>\r\n                                        29'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Tzolis tác động khiến Gakpo ngã trong vòng cấm Arsenal nhưng không có penalty cho đội chủ nhà.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>01/11/2026 | 23:56</span>\n</div>\n<h3>\r\n                                        25'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Sau quả tạt vào của Tozlis, Madueke và Timber cố gắng dứt điểm ở cự ly gần chưa thành công.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>01/11/2026 | 23:54</span>\n</div>\n<h3>\r\n                                        21'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Sau khi bị dẫn bàn, Liverpool tràn lên tấn công với những tình huống khuấy đảo bên cánh trái của Barcola.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>01/11/2026 | 23:47</span>\n</div>\n<h3>\r\n                                        16'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p><strong>Bàn thắng (0-1, Kai Havertz): </strong>Declan Rice thoát xuống cánh phải rồi căng ngang dọn cỗ cho Havertz đệm vào lưới trống mở tỷ số cho Pháo thủ thành London.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2303002353.jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/11/1/resources-premierleague-pulselive-com-2303002353-2137.jpg?width=0&amp;s=u_eD2jlNGAm_gZ3nOIIs5Q\"/></picture>\n<figcaption></figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2303002353 (1).jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/11/1/resources-premierleague-pulselive-com-2303002353-1-2136.jpg?width=0&amp;s=VpKEHOozpZSprnvv6uFlRA\"/></picture>\n<figcaption>Havertz mở tỷ số - Ảnh: Premier League</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>01/11/2026 | 23:42</span>\n</div>\n<h3>\r\n                                        11'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Arsenal đang tỏ ra nhỉnh hơn trong khâu kiểm soát bóng nhưng gặp khó trong việc tìm đường vào khung thành Alisson.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>01/11/2026 | 23:35</span>\n</div>\n<h3>\r\n                                        5'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Hai đội nhập cuộc với tốc độ cao, tạo nên thế trận hấp dẫn. Cody Gakpo vừa kết thúc chìm bằng chân phải, bóng bay chệch khung thành.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>01/11/2026 | 23:30</span>\n</div>\n<h3>\r\n                                        23h30\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Trận đấu bắt đầu.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n               