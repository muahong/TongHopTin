 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/63.png?width=0&amp;s=41UpSIIEGLF4HT1Y06ljJg\"/></picture> Leeds </a></td>\n</tr>\n<tr>\n<td>31/10/2026 22:00:00</td>\n<td><a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/55.png?width=0&amp;s=5ohwdN-BEDAzFqTxnjVMGg\"/></picture>Brentford </a> 2 - 0 <a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/65.png?width=0&amp;s=KGfIOJLdMQxebh0DS5pI5Q\"/></picture> Nottingham Forest </a></td>\n</tr>\n</tbody>\n</table>\n</div>\n<div>\n\n<div>\n<div>\n<div>\n<div>\n<div>\n\n<span>01/11/2026 | 00:08</span>\n</div>\n<h3>\r\n                                        Kết thúc\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HV VDsQW8AAHycX.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/11/1/hv-vdsqw8aahycx-3.jpg?width=0&amp;s=EbPnn3zu5pIk5SWvS-Lq_A\"/></picture>\n<figcaption>Brighton lần đầu tiên đánh bại Man City trên sân khách ở Ngoại hạng Anh - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:46</span>\n</div>\n<h3>\r\n                                        88'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Hinshelwood có cơ hội tuyệt vời để nhân đôi cách biệt nhưng cú bấm bóng chân trái kỹ thuật lại đưa bóng ra mép lưới sau.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:45</span>\n</div>\n<h3>\r\n                                        83'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Hàng thủ Brighton thi đấu tập trung gây ra nhiều khó khăn cho Man City.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:34</span>\n</div>\n<h3>\r\n                                        76'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>O'Reilly căng ngang vào cho Ndiaye lẻn xuống đệm ở góc hẹp chạm mép trên xà ngang ra ngoài.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:22</span>\n</div>\n<h3>\r\n                                        63'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Matheus Nunes xử lý hay trong vòng cấm nhưng pha kết thúc bằng chân trái chưa thắng được phản xạ xuất sắc của thủ môn Verbruggen.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:16</span>\n</div>\n<h3>\r\n                                        57'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Cherki chuyền bóng khôn ngoan cho Enzo trong vòng cấm. Tiếc rằng, cú đá của của tiền vệ người Argentina lại đi ra ngoài.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2302332679.jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/31/resources-premierleague-pulselive-com-2302332679-2779.jpg?width=0&amp;s=euzIALX-SOzXpp1thhNuiQ\"/></picture>\n<figcaption>Haaland chưa có duyên ghi bàn - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:13</span>\n</div>\n<h3>\r\n                                        55'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Hòng tìm kiếm sự đột biến, HLV Maresca tung Cherki vào sân thay cho Bouaddi.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:10</span>\n</div>\n<h3>\r\n                                        52'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Ndiaye băng lên tốc độ bên cánh phải rồi sút căng, nhưng thủ môn Brighton đẩy bóng chạm cột bật ra.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 23:06</span>\n</div>\n<h3>\r\n                                        48'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Ayari căng ngang thuận lợi cho De Cuyper băng lên trống trải. Tiếc rằng, cú đá ngay bằng chân trái quá thiếu chính xác.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 22:48</span>\n</div>\n<h3>\r\n                                        Kết thúc hiệp 1\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HV GEbWWwAAwqUv.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/31/hv-gebwwwaawquv-2644.jpg?width=0&amp;s=EPRuFLX5e6xTFbnjnbb8tA\"/></picture>\n<figcaption>45 phút đầu khép lại với tỷ số 1-0 nghiêng về Brighton - Ảnh: BHA</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 22:48</span>\n</div>\n<h3>\r\n                                        45'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Bóng liên tục bật tay Vuskovic và Dunk trong vòng cấm Brighton, nhưng trọng tài không cho Man City hưởng phạt đền.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 22:42</span>\n</div>\n<h3>\r\n                                        42'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Erling Haaland di chuyển hay để đón bóng rồi quăng chân trái sút chìm. Tuy nhiên, Dunk kịp nhoài người phá giải nguy.</p>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"resources_premierleague_pulselive_com 2302327489.jpg\" src=\"https://static-images.vnncdn.net/vps_images/000001/000003/2026/10/31/resources-premierleague-pulselive-com-2302327489-2586.jpg?width=0&amp;s=BQLGI6wegbKct7oNVKtuRQ\"/></picture>\n<figcaption>Haaland thi đấu chưa tốt từ đầu trận - Ảnh: P.L</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 22:40</span>\n</div>\n<h3>\r\n                                        38'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Man City đang tấn công tương đối bế tắc, trong bối cảnh Brighton dàn thế trận chặt chẽ với tính tổ chức cao.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 22:30</span>\n</div>\n<h3>\r\n                                        30'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Doku tả xung hữu đột bên cánh trái rồi chuyền vào cho Haaland dứt điểm hụt.</p>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>31/10/2026 | 22:26</span>\n</div>\n<h3>\r\n                                        25'\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<p>Ndiaye đột phá ngẫu hứng bên cánh phải nhưng cú đá cuối cùng không thắng được Verbruggen.</p>\n<figur