=0&amp;s=5ohwdN-BEDAzFqTxnjVMGg\"/></picture> Brentford </a></td>\n</tr>\n<tr>\n<td>25/10/2026 21:00:00</td>\n<td><a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/40.png?width=0&amp;s=B93mfKXOif2u3xjhGNIjuA\"/></picture>Liverpool </a> - <a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/51.png?width=0&amp;s=waDPQHblkrKpbh-uAO1g5Q\"/></picture> Brighton </a></td>\n</tr>\n<tr>\n<td>25/10/2026 21:00:00</td>\n<td><a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/33.png?width=0&amp;s=o20OtOW8JOnrAD_OhUNZOg\"/></picture>Manchester United </a> - <a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/35.png?width=0&amp;s=1uc6ZYiP-H5S8ZFj32inwQ\"/></picture> Bournemouth </a></td>\n</tr>\n<tr>\n<td>25/10/2026 23:30:00</td>\n<td><a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/746.png?width=0&amp;s=y9WnBxu8c_w1eawUM9s1dw\"/></picture>Sunderland </a> - <a href=\"https://vietnamnet.vn\"> <picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/63.png?width=0&amp;s=41UpSIIEGLF4HT1Y06ljJg\"/></picture> Leeds </a></td>\n</tr>\n</tbody>\n</table>\n<div>\n<article><a href=\"https://vietnamnet.vn/thu-mon-emiliano-martinez-tran-an-chelsea-sau-chan-thuong-nang-2564178.html\" title=\"Thủ môn Emiliano Martinez trấn an Chelsea sau chấn thương nặng\"><picture><img alt=\"Thủ môn Emiliano Martinez trấn an Chelsea sau chấn thương nặng\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/18/thu-mon-emiliano-martinez-tran-an-chelsea-sau-chan-thuong-nang-436.jpg?width=0&amp;s=1ace8FnMaYU3Nj-eT2qYAg\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/thu-mon-emiliano-martinez-tran-an-chelsea-sau-chan-thuong-nang-2564178.html\" title=\"Thủ môn Emiliano Martinez trấn an Chelsea sau chấn thương nặng\">Thủ môn Emiliano Martinez trấn an Chelsea sau chấn thương nặng</a></div>\n<div>Emiliano Martinez trấn an Chelsea sau khi gặp chấn thương nghiêm trọng ở trận Chelsea thắng 2-0 Everton, vòng 7 Ngoại hạng Anh, phải thực hiện ca phẫu thuật gấp.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/ket-qua-bong-da-everton-vs-chelsea-vong-7-ngoai-hang-anh-2565556.html\" title=\"Pedro Neto hóa người hùng, Chelsea đánh gục Everton\"><picture><img alt=\"Pedro Neto hóa người hùng, Chelsea đánh gục Everton\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/17/pedro-neto-hoa-nguoi-hung-chelsea-danh-guc-everton-2012.jpg?width=0&amp;s=0qFtTGMOMLyw7-SiICKQoA\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ket-qua-bong-da-everton-vs-chelsea-vong-7-ngoai-hang-anh-2565556.html\" title=\"Pedro Neto hóa người hùng, Chelsea đánh gục Everton\">Pedro Neto hóa người hùng, Chelsea đánh gục Everton</a></div>\n<div>Pedro Neto rực sáng với cú đúp đem về chiến thắng 2-0 cho Chelsea trên sân Everton, ở trận đấu sớm nhất vòng 7 Ngoại hạng Anh 2026/27.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/chelsea-nhan-tin-set-danh-2564935.html\" title=\"Chelsea nhận tin 'sét đánh'\"><picture><img alt=\"Chelsea nhận tin 'sét đánh'\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/17/chelsea-nhan-tin-set-danh-62.jpg?width=0&amp;s=19_IJLDHCaSzrL_AnrXFtw\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/chelsea-nhan-tin-set-danh-2564935.html\" title=\"Chelsea nhận tin 'sét đánh'\">Chelsea nhận tin 'sét đánh'</a></div>\n<div>Đội trưởng Chelsea - Reece James dự kiến phải nghỉ thi đấu ba tháng khi vừa trải qua ca phẫu thuật đầu gối.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/nhan-dinh-bong-da-everton-vs-chelsea-thu-thach-thay-tro-xabi-alonso-2565448.html\" title=\"Nhận định Everton vs Chelsea: Thử thách thầy trò Xabi Alonso\"><picture><img alt=\"Nhận định Everton vs Chelsea: Thử thách thầy trò Xabi Alonso\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/16/nhan-dinh-everton-vs-chelsea-thu-thach-thay-tro-xabi-alonso-1707.jpg?width=0&amp;s=r3Hd744JETEEV8Is9Mi7Mg\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/nhan-dinh-bong-da-everton-vs-chelsea-thu-thach-thay-tro-xabi-alonso-2565448.html\" title=\"Nhận định Everton vs Chelsea: Thử thách thầy trò Xabi Alonso\">Nhận định Everton vs Chelsea: Thử thách thầy trò Xabi Alonso</a></div>\n<div>Bất bại kể từ đầu mùa, Everton sẵn sàng nghênh chiến Chelsea trong trận cầu sớm nhất vòng 7 Ngoại hạng Anh, lúc 18h30 ngày 17/10 (giờ VN).</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/ket-qua-cup-c1-aston-villa-vs-fenerbahce-thang-kieu-tennis-2564846.html\" title=\"Người cũ Chelsea giúp Aston Villa thắng Fenerbahce 6-0\"><picture><img alt=\"Người cũ Chelsea giúp Aston Villa thắng Fenerbahce 6-0\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/10/15/nguoi-cu-chelsea-giup-aston-villa-thang-fenerbahce-6-0-33.jpg?width=0&amp;s=mqv8RZbOL_B8fUAX_3urKA\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ket-qua-cup-c1-aston-villa-vs-fenerbahce-thang-kieu-tennis-2564846.html\" title=\"Người cũ Chelsea giúp Aston Villa thắng Fenerbahce 6-0\">Người cũ Chelsea giúp Aston Villa thắng Fenerbahce 6-0</a></div>\n<div>Nicolas Jackson ghi cú đúp ngay trong hiệp 1, góp công giúp Aston Villa thắng tưng bừng Fenerbahce, lượt 2 vòng phân hạng Champions League.</div>\n</div>\n</article>\n</div> <!-- BEGIN COMPONENT:: COMPONENT002778 -->\n<!-- END COMPONENT:: COMPONENT002778 -->\n</div>"}