9C9gSX7e6tg\"/></source></picture>\n<figcaption></figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><source><!--[if IE 9]></video><![endif]--><img alt=\"HKjWu1ZXoAA tMF.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/6/12/hkjwu1zxoaa-tmf-104.jpg?width=0&amp;s=NO-dF5pUL-B_HYLU73j0cw\"/></source></picture>\n<figcaption></figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><source><!--[if IE 9]></video><![endif]--><img alt=\"HKjWpmgaQAAKNyR.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/6/12/hkjwpmgaqaaknyr-105.jpg?width=0&amp;s=LUKFiZzDjsmU6RjDz3alXA\"/></source></picture>\n<figcaption></figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><source><!--[if IE 9]></video><![endif]--><img alt=\"HKjWpmTbwAA0BC0.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/6/12/hkjwpmtbwaa0bc0-106.jpg?width=0&amp;s=Nkvt6NbIzWjEl-Nn-S9C7A\"/></source></picture>\n<figcaption>Bữa tiệc âm nhạc \"đã tai\" trên sân Azteca - Ảnh: FIFA</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>12/06/2026 | 01:28</span>\n</div>\n<h3>\r\n                                        1h10\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><source><!--[if IE 9]></video><![endif]--><img alt=\"721996184_5340068112885678_8401721724365610509_n.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/6/12/721996184-5340068112885678-8401721724365610509-n-74.jpg?width=0&amp;s=WPqqToubwHh_EgX3ZhEsIw\"/></source></picture>\n<figcaption></figc