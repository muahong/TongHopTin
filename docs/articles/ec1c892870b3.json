01/000003/2026/6/12/www-thesun-co-uk-nintchdbpict001087644179-1-29.jpg?width=0&amp;s=x5zc9OQwoIx_KQQ6jytHHg\"/></source></picture>\n<figcaption></figcaption>\n</figure>\n\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>12/06/2026 | 00:24</span>\n</div>\n<h3>\r\n                                        0h\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><source><!--[if IE 9]></video><![endif]--><img alt=\"www_thesun_co_uk 2026 group match mexico south 1087642584.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/6/12/www-thesun-co-uk-2026-group-match-mexico-south-1087642584-12.jpg?width=0&amp;s=UosegRpR7VDxNS46HgR3AA\"/></source></picture>\n<figcaption></figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><source><!--[if IE 9]></video><![endif]--><img alt=\"www_thesun_co_uk 2026 group match mexico south 1087642584 (1).jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/6/12/www-thesun-co-uk-2026-group-match-mexico-south-1087642584-1-13.jpg?width=0&amp;s=O_cW3fHMW6H5crBDtlMMbQ\"/></source></picture>\n<figcaption>Những chú linh vật biểu tượng cho World Cup 2026 xuất hiện trên sân Azteca - Ảnh: SunSport</figcaption>\n</figure>\n</div>\n<div>\r\n                                    Thu gọn\r\n                                    \n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<div>\n\n<span>11/06/2026 | 23:04</span>\n</div>\n<h3>\r\n                                        23h\r\n                                    </h3>\n</div>\n<div>\n<img src=\"https://static.vnncdn.net/v1/icon/down-arrow.svg\"/>\n</div>\n</div>\n<div>\n<div>\n<figure><picture><!--[if IE 9]><video style=\"d