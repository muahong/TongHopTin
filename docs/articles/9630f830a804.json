caption>Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan trưng bày tại Bảo tàng Quốc hội Việt Nam.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_6-9381.jpg\" src=\"https://cdn.nhandan.vn/images/bdfb5ed663f5c065f852999995675cedceab3632c40c09d5f8001cc509eb7512107b4f8407a1a63ae9d20f7f9052f5d1b7ae13cda333b1a658a4aa09dbd85477/ndo_br_6-9381.jpg.avif\" title=\"Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan trưng bày tại Bảo tàng Quốc hội Việt Nam.\"/> <figcaption>Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan trưng bày tại Bảo tàng Quốc hội Việt Nam.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_7-8548.jpg\" src=\"https://cdn.nhandan.vn/images/bdfb5ed663f5c065f852999995675cedceab3632c40c09d5f8001cc509eb75128e3bf630afbdf495125a90e26a55f5fab7ae13cda333b1a658a4aa09dbd85477/ndo_br_7-8548.jpg.avif\" title=\"Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan Khu trưng bày khảo cổ dưới tòa nhà Quốc hội.\"/> <figcaption>Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan Khu trưng bày khảo cổ dưới tòa nhà Quốc hội.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_8-8902.jpg\" src=\"https://cdn.nhandan.vn/images/bdfb5ed663f5c065f852999995675cedceab3632c40c09d5f8001cc509eb7512845742dd11047fd6d054484d623a2e5db7ae13cda333b1a658a4aa09dbd85477/ndo_br_8-8902.jpg.avif\" title=\"Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan Khu trưng bày.\"/> <figcaption>Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan Khu trưng bày.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_9-7669.jpg\" src=\"https://cdn.nhandan.vn/images/bdfb5ed663f5c065f852999995675cedceab3632c40c09d5f8001cc509eb7512ed21afc79663f950212a93c601e7f652b7ae13cda333b1a658a4aa09dbd85477/ndo_br_9-7669.jpg.avif\" title=\"Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan Khu trưng bày.\"/> <figcaption>Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram tham quan Khu trưng bày.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_02.jpg\" src=\"https://cdn.nhandan.vn/images/bdfb5ed663f5c065f852999995675cedceab3632c40c09d5f8001cc509eb7512741a0857620680edca2b4d20003a2996/ndo_br_02.jpg.avif\" title=\"Chủ tịch Quốc hội Trần Thanh Mẫn và Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram.\"/> <figcaption>Chủ tịch Quốc hội Trần Thanh Mẫn và Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_10-9302.jpg\" src=\"https://cdn.nhandan.vn/images/bdfb5ed663f5c065f852999995675cedceab3632c40c09d5f8001cc509eb75127f7c46ff77becf7b61c6fa71c445bb2763a899dc0d598a8828a44264337440e8/ndo_br_10-9302.jpg.avif\" title=\"Chủ tịch Quốc hội Trần Thanh Mẫn trao đổi với Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram.\"/> <figcaption>Chủ tịch Quốc hội Trần Thanh Mẫn trao đổi với Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_11-7349.jpg\" src=\"https://cdn.nhandan.vn/images/bdfb5ed663f5c065f852999995675cedceab3632c40c09d5f8001cc509eb75124dadf465ada13ba45b7f211d7abf76e063a899dc0d598a8828a44264337440e8/ndo_br_11-7349.jpg.avif\" title=\"Chủ tịch Quốc hội Trần Thanh Mẫn tiễn Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram.\"/> <figcaption>Chủ tịch Quốc hội Trần Thanh Mẫn tiễn Chủ tịch Quốc hội kiêm Chủ tịch Hạ viện Vương quốc Thái Lan Sophon Zaram.</figcaption>\n</figure> <div> <p>THỦY NGUYÊN</p> </div>  </div></body></html>"}