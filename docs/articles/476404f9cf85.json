Hd||[]--></strong><!--TgQPHd||[]--></td>\n<td>Harry Kane<!--TgQPHd||[]--></td>\n<td>🏴󠁧󠁢󠁥󠁮󠁧󠁿 Anh<!--TgQPHd||[]--></td>\n<td>6<!--TgQPHd||[]--></td>\n<td>1<!--TgQPHd||[]--></td>\n<td>Tranh hạng 3<br/><!--TgQPHd||[]--></td>\n<!--TgQPHd||[]--></tr>\n<tr>\n<td><strong>6<!--TgQPHd||[]--></strong><!--TgQPHd||[]--></td>\n<td>Ousmane Dembélé<!--TgQPHd||[]--></td>\n<td>🇫🇷 Pháp<!--TgQPHd||[]--></td>\n<td>5<!--TgQPHd||[]--></td>\n<td>2<!--TgQPHd||[]--></td>\n<td>Tranh hạng 3<br/><!--TgQPHd||[]--></td>\n<!--TgQPHd||[]--></tr>\n<tr>\n<td><strong>7<!--TgQPHd||[]--></strong><!--TgQPHd||[]--></td>\n<td>Mikel Oyarzabal<!--TgQPHd||[]--></td>\n<td>🇪🇸 Tây Ban Nha<!--TgQPHd||[]--></td>\n<td>5<!--TgQPHd||[]--></td>\n<td>1<!--TgQPHd||[]--></td>\n<td>Vào chung kết<br/><!--TgQPHd||[]--></td>\n<!--TgQPHd||[]--></tr>\n<tr>\n<td><strong>8<!--TgQPHd||[]--></strong><!--TgQPHd||[]--></td>\n<td>Vinícius Júnior<!--TgQPHd||[]--></td>\n<td>🇧🇷 Brazil<!--TgQPHd||[]--></td>\n<td>4<!--TgQPHd||[]--></td>\n<td>1<!--TgQPHd||[]--></td>\n<td>Bị loại<!--TgQPHd||[]--></td>\n<!--TgQPHd||[]--></tr>\n<tr>\n<td><strong>8<!--TgQPHd||[]--></strong><!--TgQPHd||[]--></td>\n<td>Julián Quiñones<!--TgQPHd||[]--></td>\n<td>🇲🇽 Mexico<!--TgQPHd||[]--></td>\n<td>4<!--TgQPHd||[]--></td>\n<td>1<!--TgQPHd||[]--></td>\n<td>Bị loại<!--TgQPHd||[]--></td>\n<!--TgQPHd||[]--></tr>\n<tr>\n<td><strong>8<!--TgQPHd||[]--></strong><!--TgQPHd||[]--></td>\n<td>Ismaïla Sarr<!--TgQPHd||[]--></td>\n<td>🇸🇳 Senegal<!--TgQPHd||[]--></td>\n<td>4<!--TgQPHd||[]--></td>\n<td>1<!--TgQPHd||[]--></td>\n<td>Bị loại<!--TgQPHd||[]--></td>\n<!--TgQPHd||[]--></tr>\n</tbody>\n</table>\n</div>\n\n\n\n<h3></h3>\n<h3><em>Video highlights Tây Ban Nha 2-10 Pháp (nguồn: VTV)</em></h3>\n\n\n<div>\n<div>\n<article><a href=\"https://vietnamnet.vn/lich-thi-dau-chung-ket-tranh-hang-3-world-cup-2026-moi-nhat-2535660.html\" title=\"Lịch thi đấu chung kết, tranh hạng 3 World Cup 2026 mới nhất\"><picture><img alt=\"Lịch thi đấu chung kết, tranh hạng 3 World Cup 2026 mới nhất\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/7/14/lich-thi-dau-chung-ket-tranh-hang-3-world-cup-2026-moi-nhat-2183.jpg?width=0&amp;s=4MooNCmo_n9ew0_oe4htnQ\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/lich-thi-dau-chung-ket-tranh-hang-3-world-cup-2026-moi-nhat-2535660.html\" title=\"Lịch thi đấu chung kết, tranh hạng 3 World Cup 2026 mới nhất\">Lịch thi đấu chung kết, tranh hạng 3 World Cup 2026 mới nhất</a></div>\n<div>Lịch thi đấu World Cup 2026 - VietNamNet cập nhật lịch thi trận chung kết và tranh hạng 3 World Cup 2026, nhanh, đầy đủ và chính xác nhất.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/ket-qua-bong-da-anh-vs-argentina-ban-ket-world-cup-2026-2536070.html\" title=\"Messi rực sáng, Argentina thắng ngược khó tin vào chung kết World Cup\"><picture><img alt=\"Messi rực sáng, Argentina thắng ngược khó tin vào chung kết World Cup\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/7/16/truc-tiep-anh-1-2-argentina-nguoc-dong-ngoan-muc-h2-118.jpg?width=0&amp;s=_zJBh5LlpJV1JucS9Hf4oQ\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ket-qua-bong-da-anh-vs-argentina-ban-ket-world-cup-2026-2536070.html\" title=\"Messi rực sáng, Argentina thắng ngược khó tin vào chung kết World Cup\">Messi rực sáng, Argentina thắng ngược khó tin vào chung kết World Cup</a></div>\n<div>Cú đúp kiến tạo của Lionel Messi lúc cuối trận giúp Argentina ngược dòng ngoạn mục đánh bại tuyển Anh 2-1, qua đó giành tấm vé vào chơi chung World Cup 2026 với Tây Ban Nha.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/video-bong-da-anh-vs-argentina-ban-ket-world-cup-2026-2536072.html\" title=\"Video bóng đá Anh vs Argentina: Messi truyền cảm hứng\"><picture><img alt=\"Video bóng đá Anh vs Argentina: Messi truyền cảm hứng\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/7/16/video-bong-da-anh-vs-argentina-messi-truyen-cam-hung-192.jpg?width=0&amp;s=mOYIQKrrs_5DAuociLMNJg\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/video-bong-da-anh-vs-argentina-ban-ket-world-cup-2026-2536072.html\" title=\"Video bóng đá Anh vs Argentina: Messi truyền cảm hứng\">Video bóng đá Anh vs Argentina: Messi truyền cảm hứng</a></div>\n<div>Cú đúp kiến tạo của Messi giúp Enzo Fernandez và Lautaro Martinez xé lưới tuyển Anh, Argentina thắng 2-1 để giành vé vào chung kết World Cup 2026.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/ket-qua-bong-da-phap-vs-tay-ban-nha-ban-ket-world-cup-2026-2535424.html\" title=\"Hạ gục Pháp, Tây Ban Nha lọt vào chung kết World Cup 2026\"><picture><img alt=\"Hạ gục Pháp, Tây Ban Nha lọt vào chung kết World Cup 2026\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/7/15/truc-tiep-phap-0-2-tay-ban-nha-pedro-porro-lap-dai-cong-h2-262.jpg?width=0&amp;s=Z2uaEpkuKMjCzxCZlSFJ1g\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ket-qua-bong-da-phap-vs-tay-ban-nha-ban-ket-world-cup-2026-2535424.html\" title=\"Hạ gục Pháp, Tây Ban Nha lọt vào chung kết World Cup 2026\">Hạ gục Pháp, Tây Ban Nha lọt vào chung kết World Cup 2026</a></div>\n<div>Xuất sắc đánh bại Pháp 2-0 nhờ các pha lập công của Oyarzabal và Pedro Porro, Tây Ban Nha giành tấm vé đầu tiên vào chơi trận chung kết World Cup 2026.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/video-bong-da-phap-vs-tay-ban-nha-ban-ket-world-cup-2026-2535426.html\" title=\"Video bóng đá Pháp vs Tây Ban Nha: Chiến thắng ấn tượng\"><picture><img alt=\"Video bóng đá Pháp vs Tây Ban Nha: Chiến thắng ấn tượng\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/7/15/video-bong-da-phap-vs-tay-ban-nha-chien-thang-an-tuong-335.jpg?width=0&amp;s=g4NPPV0Bls5rB6GGRLK4bw\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/video-bong-da-phap-vs-tay-ban-nha-ban-ket-world-cup-2026-2535426.html\" title=\"Video bóng đá Pháp vs Tây Ban Nha: Chiến thắng ấn tượng\">Video bóng đá Pháp vs Tây Ban Nha: Chiến thắng ấn tượng</a></div>\n<div>Tây Ban Nha thi đấu nhuần nhuyễn và hiệu quả, dễ dàng hạ Pháp 2-0 ở trận bán kết World Cup 2026, nhờ các bàn thắng của Oyarzabal và Pedro Porro.</div>\n</div>\n</article>\n</div>\n</div> <!-- BEGIN COMPONENT:: COMPONENT002778 -->\n<!-- END COMPONENT:: COMPONENT002778 -->\n</div></body></html>"}