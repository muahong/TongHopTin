cdnchinhphu.vn/zoom/218_136/334894974524682240/2026/8/3/nguyenbinh-17857428831141249762568-0-0-496-794-crop-1785742885053885652360.jpg\"/>\n</a>\n<div>\n<h2>\n<a href=\"https://baochinhphu.vn/mua-nha-o-xa-hoi-vo-than-nhan-liet-si-van-phai-xac-nhan-thu-nhap-102260803144256011.htm\" title=\"Mua nhà ở xã hội: Vợ thân nhân liệt sĩ vẫn phải xác nhận thu nhập \">Mua nhà ở xã hội: Vợ thân nhân liệt sĩ vẫn phải xác nhận thu nhập </a>\n</h2>\n</div>\n</div>\n</div>\n</div>\n<div>\n<div>\n<div>\n<a href=\"https://baochinhphu.vn/ho-so-mua-nha-o-xa-hoi-xac-nhan-thu-nhap-phai-co-phap-nhan-102260730120240622.htm\" title=\"Hồ sơ mua nhà ở xã hội: Xác nhận thu nhập phải có pháp nhân\">\n<img alt=\"Hồ sơ mua nhà ở xã hội: Xác nhận thu nhập phải có pháp nhân\" src=\"https://bcp.cdnchinhphu.vn/zoom/218_136/334894974524682240/2026/7/30/nguyenvanhung-17853876697171902418-64-0-1024-1536-crop-17853876741861230933650.png\"/>\n</a>\n<div>\n<h2>\n<a href=\"https://baochinhphu.vn/ho-so-mua-nha-o-xa-hoi-xac-nhan-thu-nhap-phai-co-phap-nhan-102260730120240622.htm\" title=\"Hồ sơ mua nhà ở xã hội: Xác nhận thu nhập phải có pháp nhân\">Hồ sơ mua nhà ở xã hội: Xác nhận thu nhập phải có pháp nhân</a>\n</h2>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n\n</div>\n</div>\n\n</article></body></html>"}