\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"editorial_uefa_com germany_v_greece_ _uefa_nations_league_2026_27_group_a2_md2 (5).jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/28/editorial-uefa-com-germany-v-greece-uefa-nations-league-2026-27-group-a2-md2-5-227.jpg?width=0&amp;s=_CD2cfh_u3vQXAXupZRxcg\"/></picture>\n<figcaption>Chiến thắng để đời của các cầu thủ Hy Lạp</figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HTQD0chWYAALf S.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/28/htqd0chwyaalf-s-228.jpg?width=0&amp;s=FyFDdgh9VxGpSfvLHb4loA\"/></picture>\n<figcaption>Hy Lạp tạo ra cú sốc lớn ở Nations League</figcaption>\n</figure>\n<figure><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"HTQIXVlXcAEAkhW.jpg\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/28/htqixvlxcaeakhw-230.jpg?width=0&amp;s=QK8tHylqZR3ytiJJ8tBS1Q\"/></picture>\n<figcaption>Kết quả các trận Nations League rạng sáng 28/9</figcaption>\n</figure>\n<p><em>Nguồn ảnh: Uefa</em></p>\n<div>\n<article><a href=\"https://vietnamnet.vn/chang-can-ronaldo-bo-dao-nha-van-ha-guc-na-uy-2-1-2558136.html\" title=\"Chẳng cần Ronaldo, Bồ Đào Nha vẫn hạ gục Na Uy\"><picture><img alt=\"Chẳng cần Ronaldo, Bồ Đào Nha vẫn hạ gục Na Uy\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/28/chang-can-ronaldo-bo-dao-nha-van-ha-guc-na-uy-190.jpg?width=0&amp;s=-kypNRUL0IfdgmExdNM_nw\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/chang-can-ronaldo-bo-dao-nha-van-ha-guc-na-uy-2-1-2558136.html\" title=\"Chẳng cần Ronaldo, Bồ Đào Nha vẫn hạ gục Na Uy\">Chẳng cần Ronaldo, Bồ Đào Nha vẫn hạ gục Na Uy</a></div>\n<div>Cristiano Ronaldo dự bị cả trận, Bồ Đào Nha vẫn xuất sắc đánh gục chủ nhà Na Uy 2-1 nhờ các pha lập công của Joao Felix và Goncalo Ramos.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/ha-lan-thang-tran-dau-tien-duoi-thoi-tan-hlv-xavi-2558133.html\" title=\"Hà Lan thắng trận đầu tiên dưới thời tân HLV Xavi\"><picture><img alt=\"Hà Lan thắng trận đầu tiên dưới thời tân HLV Xavi\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/28/ha-lan-thang-tran-dau-tien-duoi-thoi-tan-hlv-xavi-162.jpg?width=0&amp;s=695czGWi1jvwmHdY0B0pPQ\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ha-lan-thang-tran-dau-tien-duoi-thoi-tan-hlv-xavi-2558133.html\" title=\"Hà Lan thắng trận đầu tiên dưới thời tân HLV Xavi\">Hà Lan thắng trận đầu tiên dưới thời tân HLV Xavi</a></div>\n<div>Xavi cùng các học trò nở nụ cười chiến thắng khi Hà Lan đánh bại chủ nhà Serbia 2-1, trong trận cầu thuộc khuôn khổ Nations League.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/ket-qua-bong-da-ha-lan-1-1-duc-uefa-nations-league-2558630.html\" title=\"Đức rơi chiến thắng trước Hà Lan ngày ra mắt Jurgen Klopp\"><picture><img alt=\"Đức rơi chiến thắng trước Hà Lan ngày ra mắt Jurgen Klopp\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/25/duc-roi-chien-thang-truoc-ha-lan-ngay-ra-mat-jurgen-klopp-204.jpg?width=0&amp;s=jUGHp4sPlk0PS34wEMSx1A\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ket-qua-bong-da-ha-lan-1-1-duc-uefa-nations-league-2558630.html\" title=\"Đức rơi chiến thắng trước Hà Lan ngày ra mắt Jurgen Klopp\">Đức rơi chiến thắng trước Hà Lan ngày ra mắt Jurgen Klopp</a></div>\n<div>Cody Gakpo ghi bàn ở phút bù giờ giúp Hà Lan cầm hòa Đức 1-1, trong trận đầu tiên của Jurgen Klopp trên cương vị HLV trưởng \"cỗ xe tăng\".</div>\n</div>\n</article>\n</div> <!-- BEGIN COMPONENT:: COMPONENT002778 -->\n<!-- END COMPONENT:: COMPONENT002778 -->\n</div>"}