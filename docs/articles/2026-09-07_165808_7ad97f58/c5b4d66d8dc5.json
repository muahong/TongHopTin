.io/football/teams/36.png?width=0&amp;s=s_ZRpaGkYQt_6_wOsY8Prg\"/></picture>Fulham</a></td>\n<td>3</td>\n<td>0</td>\n<td>0</td>\n<td>3</td>\n<td>-3</td>\n<td>0</td>\n</tr>\n<tr>\n<td>20</td>\n<td><a href=\"https://vietnamnet.vn\"><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/1346.png?width=0&amp;s=bfMhHXGjYyP5unBRvu_a2w\"/></picture>Coventry</a></td>\n<td>3</td>\n<td>0</td>\n<td>0</td>\n<td>3</td>\n<td>-5</td>\n<td>0</td>\n</tr>\n</tbody>\n</table>\n\n<div>\n<div>\n<ul>\n<li><span>Xuống hạng</span></li>\n</ul>\n</div>\n</div>\n<div>\n<article><a href=\"https://vietnamnet.vn/ket-qua-bong-da-everton-2-2-mu-vong-3-ngoai-hang-anh-2552409.html\" title=\"MU đánh rơi chiến thắng phút bù giờ cuối cùng\"><picture><img alt=\"MU đánh rơi chiến thắng phút bù giờ cuối cùng\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/6/mu-danh-roi-chien-thang-phut-bu-gio-cuoi-cung-2153.jpg?width=0&amp;s=Lz-x7ntmiTCnlXj5uqotWA\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ket-qua-bong-da-everton-2-2-mu-vong-3-ngoai-hang-anh-2552409.html\" title=\"MU đánh rơi chiến thắng phút bù giờ cuối cùng\">MU đánh rơi chiến thắng phút bù giờ cuối cùng</a></div>\n<div>Liên tục vươn lên dẫn trước Everton, nhưng MU không thể bảo vệ thành quả khi Maitland-Niles gỡ hòa 2-2 ở phút 96.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/mu-lo-ke-hoach-nua-ty-bang-de-vo-dich-premier-league-2551192.html\" title=\"MU lộ kế hoạch nửa tỷ bảng để vô địch Premier League\"><picture><img alt=\"MU lộ kế hoạch nửa tỷ bảng để vô địch Premier League\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/4/mu-lo-ke-hoach-nua-ty-bang-de-vo-dich-premier-league-2162.jpg?width=0&amp;s=KHcWq6GZjAk6YcQ2E3l7HA\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/mu-lo-ke-hoach-nua-ty-bang-de-vo-dich-premier-league-2551192.html\" title=\"MU lộ kế hoạch nửa tỷ bảng để vô địch Premier League\">MU lộ kế hoạch nửa tỷ bảng để vô địch Premier League</a></div>\n<div>Truyền thông Anh cho biết MU đang chuẩn bị kế hoạch 500 triệu bảng cho kỳ chuyển nhượng mùa hè 2027, vì danh hiệu Premier League.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/fan-mu-doi-sep-chuyen-nhuong-jason-wilcox-tu-chuc-2550779.html\" title=\"Fan MU đòi sếp chuyển nhượng Jason Wilcox từ chức\"><picture><img alt=\"Fan MU đòi sếp chuyển nhượng Jason Wilcox từ chức\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/3/fan-mu-doi-sep-chuyen-nhuong-jason-wilcox-tu-chuc-523.jpg?width=0&amp;s=2nasp-Qte7Wa6A6yxjEcMA\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/fan-mu-doi-sep-chuyen-nhuong-jason-wilcox-tu-chuc-2550779.html\" title=\"Fan MU đòi sếp chuyển nhượng Jason Wilcox từ chức\">Fan MU đòi sếp chuyển nhượng Jason Wilcox từ chức</a></div>\n<div>Người hâm mộ MU đang hướng sự chỉ trích dữ dội về phía Jason Wilcox, yêu cầu vị Giám đốc kỹ thuật từ chức sau khi Quỷ đỏ khép lại kỳ chuyển nhượng thất vọng.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/ly-do-mu-bo-y-dinh-ky-sao-man-city-vao-phut-chot-2550414.html\" title=\"Lý do MU bỏ ý định ký sao Man City vào phút chót\"><picture><img alt=\"Lý do MU bỏ ý định ký sao Man City vào phút chót\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/2/rodri-o-barca-824.jpg?width=0&amp;s=cRylAjgscDOQqu4wpRI05g\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/ly-do-mu-bo-y-dinh-ky-sao-man-city-vao-phut-chot-2550414.html\" title=\"Lý do MU bỏ ý định ký sao Man City vào phút chót\">Lý do MU bỏ ý định ký sao Man City vào phút chót</a></div>\n<div>MU định ký sao Man City để bổ sung đội hình cho Michael Carrick, nhưng từ bỏ vào phút chót bởi điều kiện người ‘hàng xóm’ đưa ra.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/mu-thuong-lon-cho-doi-truong-bruno-fernandes-2550773.html\" title=\"MU thưởng lớn cho đội trưởng Bruno Fernandes\"><picture><img alt=\"MU thưởng lớn cho đội trưởng Bruno Fernandes\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/1/mu-thuong-lon-cho-doi-truong-bruno-fernandes-22.jpg?width=0&amp;s=Hy5a3h3bY5lXMRewDcnO2A\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/mu-thuong-lon-cho-doi-truong-bruno-fernandes-2550773.html\" title=\"MU thưởng lớn cho đội trưởng Bruno Fernandes\">MU thưởng lớn cho đội trưởng Bruno Fernandes</a></div>\n<div>MU sẵn sàng biến Bruno Fernandes trở thành cầu thủ hưởng lương cao nhất CLB bằng bản hợp đồng mới, tưởng thưởng cho những đóng góp nổi bật của tiền vệ Bồ Đào Nha.</div>\n</div>\n</article>\n</div> <!-- BEGIN COMPONENT:: COMPONENT002778 -->\n<!-- END COMPONENT:: COMPONENT002778 -->\n</div>"}