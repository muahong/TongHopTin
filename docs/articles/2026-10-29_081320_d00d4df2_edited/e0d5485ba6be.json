anta</a></td>\n<td>8</td>\n<td>3</td>\n<td>1</td>\n<td>4</td>\n<td>-1</td>\n<td>10</td>\n</tr>\n<tr>\n<td>13</td>\n<td><a href=\"https://vietnamnet.vn\"><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/495.png?width=0&amp;s=Pw41uTnttyAZ7qwIyMV-Pw\"/></picture>Genoa</a></td>\n<td>9</td>\n<td>3</td>\n<td>1</td>\n<td>5</td>\n<td>-5</td>\n<td>10</td>\n</tr>\n<tr>\n<td>14</td>\n<td><a href=\"https://vietnamnet.vn\"><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/867.png?width=0&amp;s=ooiqlyBN9FW30Q7JvkJCQA\"/></picture>Lecce</a></td>\n<td>8</td>\n<td>3</td>\n<td>0</td>\n<td>5</td>\n<td>-5</td>\n<td>9</td>\n</tr>\n<tr>\n<td>15</td>\n<td><a href=\"https://vietnamnet.vn\"><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/488.png?width=0&amp;s=4zdUN2UKLFifrbkPnVomzQ\"/></picture>Sassuolo</a></td>\n<td>9</td>\n<td>2</td>\n<td>2</td>\n<td>5</td>\n<td>-8</td>\n<td>8</td>\n</tr>\n<tr>\n<td>16</td>\n<td><a href=\"https://vietnamnet.vn\"><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/1579.png?width=0&amp;s=CTyAswUQnW0OdBI6j7XklQ\"/></picture>Monza</a></td>\n<td>9</td>\n<td>2</td>\n<td>1</td>\n<td>6</td>\n<td>-6</td>\n<td>7</td>\n</tr>\n<tr>\n<td>17</td>\n<td><a href=\"https://vietnamnet.vn\"><picture><!--[if IE 9]><video style=\"display: none;\"><![endif]--><!--[if IE 9]></video><![endif]--><img alt=\"\" src=\"https://static.vnncdn.net/media.api-sports.io/football/teams/494.png?width=0&amp;s=NqAHBKUskRjUVdCIjy5EDw\"/></picture>Udinese</a></td>\n<td>9</td>\n