td>\n<p><span>22/09</span></p>\n<p><span>14:00</span></p>\n</td>\n<td>\n<p><span>Tranh HCĐ</span></p>\n</td>\n<td>\n\n</td>\n<td>\n<p><span>Thua bán kết 1</span></p>\n</td>\n<td></td>\n<td>\n<p><span>Thua bán kết 2</span></p>\n</td>\n<td>\n\n</td>\n</tr>\n<tr>\n<td>\n<p><span>22/09</span></p>\n<p><span>17:20</span></p>\n</td>\n<td>\n<p><span>Chung kết</span></p>\n</td>\n<td>\n\n</td>\n<td>\n<p><span>Thắng bán kết 1</span></p>\n</td>\n<td></td>\n<td>\n<p><span>Thắng bán kết 2</span></p>\n</td>\n<td>\n\n</td>\n</tr>\n</tbody>\n</table>\n<div>\n<article><a href=\"https://vietnamnet.vn/lich-thi-dau-cua-u23-viet-nam-tai-asiad-2026-2538328.html\" title=\"Lịch thi đấu của U23 Việt Nam tại ASIAD 2026\"><picture><img alt=\"Lịch thi đấu của U23 Việt Nam tại ASIAD 2026\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/7/23/lich-thi-dau-cua-u23-viet-nam-tai-asiad-2026-663.jpg?width=0&amp;s=fQs1s1Z2MtD5Wn2r2lwZZw\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/lich-thi-dau-cua-u23-viet-nam-tai-asiad-2026-2538328.html\" title=\"Lịch thi đấu của U23 Việt Nam tại ASIAD 2026\">Lịch thi đấu của U23 Việt Nam tại ASIAD 2026</a></div>\n<div>U23 Việt Nam chuẩn bị bước vào ASIAD 2026 với những đối thủ hàng đầu châu lục, mở ra cơ hội chinh phục cột mốc mới cho bóng đá nam Việt Nam trên đấu trường châu Á.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/tuyen-nu-viet-nam-thang-doi-trung-quoc-truoc-asiad-2552280.html\" title=\"Tuyển nữ Việt Nam thắng đội Trung Quốc trước Asiad\"><picture><img alt=\"Tuyển nữ Việt Nam thắng đội Trung Quốc trước Asiad\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/5/tuyen-nu-viet-nam-thang-doi-trung-quoc-truoc-asiad-2145.jpeg?width=0&amp;s=FH1DB0zWGoCfTFrtI_IMWA\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/tuyen-nu-viet-nam-thang-doi-trung-quoc-truoc-asiad-2552280.html\" title=\"Tuyển nữ Việt Nam thắng đội Trung Quốc trước Asiad\">Tuyển nữ Việt Nam thắng đội Trung Quốc trước Asiad</a></div>\n<div>Pha lập công duy nhất của Hải Yến giúp tuyển nữ Việt Nam thắng CLB nữ Jiangsu 1-0 ở trận giao hữu chuẩn bị cho Asiad 20.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/tay-dap-bong-chuyen-vi-thi-nhu-quynh-lo-hen-voi-asiad-2551596.html\" title=\"Tay đập bóng chuyền Vi Thị Như Quỳnh lỡ hẹn với Asiad\"><picture><img alt=\"Tay đập bóng chuyền Vi Thị Như Quỳnh lỡ hẹn với Asiad\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/9/3/tay-dap-bong-chuyen-vi-thi-nhu-quynh-lo-hen-voi-asiad-1502.jpg?width=0&amp;s=lIThHOBmMnZ-yt1Ag7jZLA\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/tay-dap-bong-chuyen-vi-thi-nhu-quynh-lo-hen-voi-asiad-2551596.html\" title=\"Tay đập bóng chuyền Vi Thị Như Quỳnh lỡ hẹn với Asiad\">Tay đập bóng chuyền Vi Thị Như Quỳnh lỡ hẹn với Asiad</a></div>\n<div>Chủ công Vi Thị Như Quỳnh không thể cùng tuyển bóng chuyền nữ Việt Nam tham dự Asiad 20 tại Nhật Bản.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/doan-the-thao-viet-nam-du-asiad-voi-gan-500-thanh-vien-2550667.html\" title=\"Đoàn thể thao Việt Nam dự Asiad với gần 500 thành viên\"><picture><img alt=\"Đoàn thể thao Việt Nam dự Asiad với gần 500 thành viên\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/8/29/doan-the-thao-viet-nam-du-asiad-voi-gan-500-thanh-vien-2451.jpg?width=0&amp;s=b_fT7AY4A0rJnQWnaVj4oQ\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/doan-the-thao-viet-nam-du-asiad-voi-gan-500-thanh-vien-2550667.html\" title=\"Đoàn thể thao Việt Nam dự Asiad với gần 500 thành viên\">Đoàn thể thao Việt Nam dự Asiad với gần 500 thành viên</a></div>\n<div>Đoàn thể thao Việt Nam (TTVN) tham dự Đại hội Thể thao châu Á 2026 (Asiad 20) với 498 thành viên, trong đó có 348 VĐV.</div>\n</div>\n</article>\n<article><a href=\"https://vietnamnet.vn/vi-sao-dinh-bac-khong-cung-u23-viet-nam-du-asiad-2550669.html\" title=\"Vì sao Đình Bắc không cùng U23 Việt Nam dự Asiad?\"><picture><img alt=\"Vì sao Đình Bắc không cùng U23 Việt Nam dự Asiad?\" src=\"https://static-images.vnncdn.net/vps_images_publish/000001/000003/2026/8/30/vi-sao-dinh-bac-khong-cung-u23-viet-nam-du-asiad-4.jpg?width=0&amp;s=xMVU_K1vnHyA-HU3pmUjxQ\"/></picture></a>\n<div>\n<div><a href=\"https://vietnamnet.vn/vi-sao-dinh-bac-khong-cung-u23-viet-nam-du-asiad-2550669.html\" title=\"Vì sao Đình Bắc không cùng U23 Việt Nam dự Asiad?\">Vì sao Đình Bắc không cùng U23 Việt Nam dự Asiad?</a></div>\n<div>Tiền đạo Nguyễn Đình Bắc cùng thủ môn Trần Trung Kiên không có tên trong danh sách sơ bộ U23 Việt Nam dự Asiad 20 tại Nhật Bản.</div>\n</div>\n</article>\n</div> <!-- BEGIN COMPONENT:: COMPONENT002778 -->\n<!-- END COMPONENT:: COMPONENT002778 -->\n</div>"}