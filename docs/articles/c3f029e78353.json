{"content_html": "<html><body><div> <figure> <img alt=\"ndo_br_ngay-thi-dau-tien-tnthpt-2837.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ec2855f7450af8ad871a742556b73ea3ad7bc90df7cc0bd1d365290a4b1bfabcd333672caaf2213337a33e2d0c40f099ae/ndo_br_ngay-thi-dau-tien-tnthpt-2837.jpg.avif\" title=\"Khoảnh khắc cánh cổng điểm thi hé mở, đôi bạn cùng tiến phấn khởi ùa ra trong lời cổ vũ nhiệt tình từ mọi người chung quanh.\"/> <figcaption>Khoảnh khắc cánh cổng điểm thi hé mở, đôi bạn cùng tiến phấn khởi ùa ra trong lời cổ vũ nhiệt tình từ mọi người chung quanh.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-tnthpt-2-2957.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ecf49d739254e0bb753d0f2ecd191311f1337112732c903b140f8006f4e29a729cb7ae13cda333b1a658a4aa09dbd85477/ndo_br_ngay-thi-tnthpt-2-2957.jpg.avif\" title=\"Cái ôm ấm áp của mẹ dành cho cô con gái nhỏ.\"/> <figcaption>Cái ôm ấm áp của mẹ dành cho cô con gái nhỏ.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-tnthpt-2-3038.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ecf49d739254e0bb753d0f2ecd191311f11b4678b37dea7620ec4474bee37398c7b7ae13cda333b1a658a4aa09dbd85477/ndo_br_ngay-thi-tnthpt-2-3038.jpg.avif\" title=\"Lời dặn dò từ người thân đến sĩ tử.\"/> <figcaption>Lời dặn dò từ người thân đến sĩ tử.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-dau-tien-tnthpt-2612.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ec2855f7450af8ad871a742556b73ea3ad7bc90df7cc0bd1d365290a4b1bfabcd3d8331af8a4f85cb55885c7ffb10eac92/ndo_br_ngay-thi-dau-tien-tnthpt-2612.jpg.avif\" title=\"Còn nhớ, tại điểm thi Trường trung học phổ thông Trần Phú (Hà Nội), một thí sinh gặp chấn thương ở chân được các chiến sĩ công an nhiệt tình hỗ trợ.\"/> <figcaption> Còn nhớ, tại điểm thi Trường trung học phổ thông Trần Phú (Hà Nội), một thí sinh gặp chấn thương ở chân được các chiến sĩ công an nhiệt tình hỗ trợ. <br/> </figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_ngay-thi-tnthpt-2-3243.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ecf49d739254e0bb753d0f2ecd191311f1bcc512a3e46e7f6dcdd6988ce8b973e9b7ae13cda333b1a658a4aa09dbd85477/ndo_br_ngay-thi-tnthpt-2-3243.jpg.avif\" title=\"Hàng dài phụ huynh kiên nhẫn đứng chờ con em - hình ảnh quen thuộc trong những mùa thi.\"/> <figcaption>Hàng dài phụ huynh kiên nhẫn đứng chờ con em - hình ảnh quen thuộc trong những mùa thi.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-dau-tien-tnthpt-2782.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ec2855f7450af8ad871a742556b73ea3ad7bc90df7cc0bd1d365290a4b1bfabcd35bdc1fe98f2b788291a908e0332bf497/ndo_br_ngay-thi-dau-tien-tnthpt-2782.jpg.avif\" title=\"Những tràng pháo tay, lời tán dương, khích lệ từ đội ngũ tình nguyện viên dành cho các sĩ tử.\"/> <figcaption>Những tràng pháo tay, lời tán dương, khích lệ từ đội ngũ tình nguyện viên dành cho các sĩ tử.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-dau-tien-tnthpt-2824.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ec2855f7450af8ad871a742556b73ea3ad7bc90df7cc0bd1d365290a4b1bfabcd33d45e06a9f811639bf3cb01296dd2db5/ndo_br_ngay-thi-dau-tien-tnthpt-2824.jpg.avif\" title=\"Và cả sự tự hào của cha mẹ khi con đã nỗ lực hết sức mình.\"/> <figcaption>Và cả sự tự hào của cha mẹ khi con đã nỗ lực hết sức mình.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-tnthpt-2-3346.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ecf49d739254e0bb753d0f2ecd191311f1696bbb2cf1a605815dab39149ec3fcbcb7ae13cda333b1a658a4aa09dbd85477/ndo_br_ngay-thi-tnthpt-2-3346.jpg.avif\" title=\"Kết thúc kỳ thi, thí sinh hân hoan khi hoàn thành một dấu mốc quan trọng trên chặng đường học tập.\"/> <figcaption>Kết thúc kỳ thi, thí sinh hân hoan khi hoàn thành một dấu mốc quan trọng trên chặng đường học tập.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_ngay-thi-tnthpt-2-3367.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ecf49d739254e0bb753d0f2ecd191311f185879c1f0e22cd6a9dd4f442ee7b164cb7ae13cda333b1a658a4aa09dbd85477/ndo_br_ngay-thi-tnthpt-2-3367.jpg.avif\" title=\"Chặng đường ấy, luôn có sự sát cánh của những người bạn thân thiết.\"/> <figcaption>Chặng đường ấy, luôn có sự sát cánh của những người bạn thân thiết.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-tnthpt-2-3209.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ecf49d739254e0bb753d0f2ecd191311f14f4a34d552b3ceea467f93989ad7d485b7ae13cda333b1a658a4aa09dbd85477/ndo_br_ngay-thi-tnthpt-2-3209.jpg.avif\" title=\"&amp;quot;Ê-kip cổ động viên&amp;quot; đáng yêu túc trực trước điểm thi.\"/> <figcaption>\"Ê-kip cổ động viên\" đáng yêu túc trực trước điểm thi.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-dau-tien-tnthpt-2012.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ec2855f7450af8ad871a742556b73ea3ad7bc90df7cc0bd1d365290a4b1bfabcd3248997ca1822a6408766ecc6ee2af782/ndo_br_ngay-thi-dau-tien-tnthpt-2012.jpg.avif\" title=\"Kỳ thi này diễn ra an toàn, suôn sẻ một phần là nhờ sự góp sức, hỗ trợ từ các chiến sĩ công an.\"/> <figcaption>Kỳ thi này diễn ra an toàn, suôn sẻ một phần là nhờ sự góp sức, hỗ trợ từ các chiến sĩ công an.</figcaption>\n</figure>\n<figure> <img alt=\"ndo_br_ngay-thi-tnthpt-2-3006.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ecf49d739254e0bb753d0f2ecd191311f18be83dbd34b87220d15242a819d0f37cb7ae13cda333b1a658a4aa09dbd85477/ndo_br_ngay-thi-tnthpt-2-3006.jpg.avif\" title=\"Không ngại nắng, mưa, các chiến sĩ đã túc trực tại điểm thi, phân luồng và bảo đảm an toàn, giao thông thông suốt.\"/> <figcaption>Không ngại nắng, mưa, các chiến sĩ đã túc trực tại điểm thi, phân luồng và bảo đảm an toàn, giao thông thông suốt.</figcaption>\n</figure>\n\n<figure> <img alt=\"ndo_br_ngay-thi-dau-tien-tnthpt-2166.jpg\" src=\"https://cdn.nhandan.vn/images/f40e03b5ac987691f13b461c94e49ae27297e969acd12a99bbd1441e708fb1ec2855f7450af8ad871a742556b73ea3ad7bc90df7cc0bd1d365290a4b1bfabcd3c4fe439d718d2ff970be8cb1c894ed00/ndo_br_ngay-thi-dau-tien-tnthpt-2166.jpg.avif\" title=\"Sức &amp;quot;nóng&amp;quot; tại các điểm thi còn được xoa dịu bởi đội ngũ thanh niên tình nguyện đầy năng động.\"/> <figcaption>Sức \"nóng\" tại các điểm thi còn được xoa dịu bởi đội ngũ thanh niên tình nguyện đầy năng động.</figcaption>\n</figure> <div> <p>QUỲNH ANH</p> </div>  </div></body></html>"}