if\"/>\n</figure>\n\n<figure> <img alt=\"info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-5.jpg\" src=\"https://media.vietnamplus.vn/images/gkxiusytSLUQcf6B1Pl1YmutLVQfkBs8ocrAbiD01mkRgc64qw_shcN8yjEgfife4iW3oM3jaMbp0ZTqiPzFhEli41Y3DSpi_Al8gIAN3uCkFO8vcCDHkSou9_cgC7KiOERMxLSpHT0R7dddQglL3ztVttsIdjqEnQaVfnITcYY/info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-5.jpg.avif\"/>\n</figure>\n<figure> <img alt=\"info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-6.jpg\" src=\"https://media.vietnamplus.vn/images/gkxiusytSLUQcf6B1Pl1YmutLVQfkBs8ocrAbiD01mkRgc64qw_shcN8yjEgfife4iW3oM3jaMbp0ZTqiPzFhEli41Y3DSpi_Al8gIAN3uCkFO8vcCDHkSou9_cgC7KiOERMxLSpHT0R7dddQglL36eRoxn07aUZOPnb2-3LfDo/info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-6.jpg.avif\"/>\n</figure>\n<figure> <img alt=\"info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-7.jpg\" src=\"https://media.vietnamplus.vn/images/gkxiusytSLUQcf6B1Pl1YmutLVQfkBs8ocrAbiD01mkRgc64qw_shcN8yjEgfife4iW3oM3jaMbp0ZTqiPzFhEli41Y3DSpi_Al8gIAN3uCkFO8vcCDHkSou9_cgC7KiOERMxLSpHT0R7dddQglL3_iHYnU99dCyjrmhrR03Pgk/info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-7.jpg.avif\"/>\n</figure>\n\n<figure> <img alt=\"info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-8.jpg\" src=\"https://media.vietnamplus.vn/images/gkxiusytSLUQcf6B1Pl1YmutLVQfkBs8ocrAbiD01mkRgc64qw_shcN8yjEgfife4iW3oM3jaMbp0ZTqiPzFhEli41Y3DSpi_Al8gIAN3uCkFO8vcCDHkSou9_cgC7KiOERMxLSpHT0R7dddQglL363grrRVhXqo5O9qtRZFdy0/info-tong-bi-thu-chu-tich-nuoc-to-lam-tai-hoi-nghi-thuong-dinh-doanh-nghiep-apec-2026-phan-8.jpg.avif\"/>\n</figure>\n<p>Chiều 18/11, tại Thâm Quyến (Trung Quốc), Tổng Bí thư, Chủ tịch nước Tô Lâm đã có bài phát biểu quan trọng tại Hội nghị Thượng đỉnh Doanh nghiệp APEC 2026.</p>\n<p>Chia sẻ tầm nhìn phát triển của Việt Nam trong kỷ nguyên mới, Tổng Bí thư, Chủ tịch nước đề xuất 3 định hướng chiến lược cho APEC, khẳng định cam kết đồng hành cùng nhà đầu tư và trân trọng mời cộng đồng doanh nghiệp đến với Năm APEC 2027 tại Việt Nam./.</p>\n <div> <div> <span>(TTXVN/Vietnam+)</span> </div> </div>  </div>"}