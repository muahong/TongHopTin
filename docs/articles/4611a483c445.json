{"content_html": "<html><body><div>\n<div>\n<div>\n<div>\n<span><a href=\"javascript:;\" title=\"TIN MỚI\">TIN MỚI</a></span>\n<ul>\n</ul>\n</div>\n</div>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 1.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a067c7953047fd20d87deb53c0ee3f36929/tp-c_1-8175.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 1.\"/>\n</div>\n<figcaption>\n<p>\n   Quốc lộ 13, tuyến đường huyết mạch nối liền TPHCM với Bình Dương và Bình Phước cũ, đang chứng kiến sự \"thay da đổi thịt\" với các dự án nâng cấp, mở rộng quy mô lớn.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 2.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a0657c0c84bc1f18efaab5ab24586095966/tp-c_2.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 2.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án nâng cấp, mở rộng Quốc lộ 13 đoạn qua Bình Dương cũ, khởi công từ năm 2022 với tổng vốn đầu tư hơn 6.000 tỷ đồng, đang được các nhà thầu đẩy nhanh tiến độ. Đoạn đường dài gần 15 km này sẽ được mở rộng từ 6 lên 8 làn xe.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 3.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06219e3b64ae27dcea67d95c5534a10723/tp-c_1-361.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 3.\"/>\n</div>\n<figcaption>\n<p>\n   Diện mạo quốc lộ 13 thay đổi, kéo theo hàng chục dự án bất động sản đua nhau mọc lên.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 4.\" src=\"https://cdn.tienphong.vn/images/13b59c04eec3ff7e59918138cd826118646a4748254d6c3b5a27f53b606699ab9bdfeb6ca27c8d87a0beab57adb2bf24/img-6158.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 4.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án The Emeral 68 tọa lạc mặt tiền đường Quốc Lộ 13 đang hot hiện nay\n  </p>\n</figcaption>\n</figure>\n<p>\n ​\n</p>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 5.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a060f2242cf900d942ce87a20e6511e629a/tp-c_2-5779.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 5.\"/>\n</div>\n<figcaption>\n<p>\n   Trong đó, dự án Lusso Saigon (thuộc tổ hợp Khu đô thị La Pura) tọa lạc trên mặt tiền Quốc lộ 13 đang được rao bán với giá từ 48 triệu đồng/m2.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 6.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06aa113acf81463fc129a2ecd6bda0a742/tp-c_3.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 6.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án này do Công ty CP Phát triển Bất động sản Phát Đạt làm chủ đầu tư.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 7.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a069b0f914f7fd6872348e57ae698ca8b46/tp-c_4.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 7.\"/>\n</div>\n<figcaption>\n<p>\n   Lusso Saigon hiện được phân phối thông qua Việt Á Land.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 8.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06b371849431fb77c05f5fa2820850e565/tp-c_5.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 8.\"/>\n</div>\n<figcaption>\n<p>\n   Tương tự, Diamond Boulevard (chung cư Tân An Bình Dương) là dự án căn hộ phân khúc cao cấp nằm ngay mặt tiền quốc lộ 13.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 9.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06263c45413d3eaf03f7a8c843dcf852cf/tp-c_7.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 9.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án do Công ty CP Tổng Công ty Tecco Miền Nam làm chủ đầu tư.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 10.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a069563b66f1476bef1e9caebbbaaac2626/tp-c_6.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 10.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án có hơn 650 căn hộ và đang bước vào giai đoạn hoàn thiện để bàn giao nhà cho khách hàng.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 11.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a066fc08f9309c0f3f91654f823b0eefd83/tp-c_9.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 11.\"/>\n</div>\n<figcaption>\n<p>\n   The Habitat Bình Dương là khu căn hộ cao cấp tọa lạc tại mặt tiền Đại lộ Hữu Nghị, cổng vào Khu công nghiệp VSIP 1, kết nối trực tiếp với quốc lộ 13.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 12.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a0658be408912dbed6f6be694109fdc5c92/tp-c_11.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 12.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án này rộng hơn 4 ha, phát triển qua nhiều giai đoạn.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 13.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a0690451f7f48d6d8578859b247ad856cf1/tp-c_10.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 13.\"/>\n</div>\n<figcaption>\n<p>\n   The Habitat Bình Dương là dự án bất động sản do Công ty TNHH Phát triển VSIP - Sembcorp Gateway thực hiện.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 14.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06aed8a1fa6cc4e9fb905a917727390953/tp-c_12.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 14.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án Symlife (hay Symphony of Life) là tổ hợp căn hộ chung cư cao cấp tọa lạc tại mặt tiền quốc lộ 13, giáp ranh với TP. Thủ Đức cũ.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 15.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06b1188c80216d0eb89be95fc6a11e46c6/tp-c_13.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 15.\"/>\n</div>\n<figcaption>\n<p>\n   Chủ đầu tư dự án là Công ty CP Đầu tư Xây dựng Nam Hiệp Thành Bình Dương với 659 căn hộ.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 16.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06d152ba14050c768eff3d719f64f6f23b/tp-c_14.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 16.\"/>\n</div>\n<figcaption>\n<p>\n   Lavita Thuận An là dự án tổ hợp căn hộ chung cư cao cấp tọa lạc tại mũi tàu quốc lộ 13 và đường Nguyễn Thị Minh Khai.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 17.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a060c82b55ea961816380d7aafb04f03fa7/tp-c_15.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 17.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án do Công ty CP Bất động sản Thuận An làm chủ đầu tư và được phát triển bởi Hưng Thịnh Land (thuộc Tập đoàn Hưng Thịnh).\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 18.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a069a3550c4f6cc62f1e9dd43831713abef/tp-c_17.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 18.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án gồm 4 block căn hộ cao từ 33 - 38 tầng nổi cùng với 2 tầng hầm đỗ xe.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 19.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a060a834b921fa2b1b15464b4d46886d5b9/tp-c_16.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 19.\"/>\n</div>\n<figcaption>\n<p>\n   Lavita Thuận An có 1.758 căn hộ chung cư, 672 căn officetel và 48 căn shophouse khối đế.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 20.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9768036c3b6cf6e9d0bd38a201a3ca0e1756a4cc3a4ef4b927ab35bb17242a690/1-135.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 20.\"/>\n</div>\n<figcaption>\n<p>\n   Trên quốc lộ 13 cũng có rất nhiều dự án đang xây dựng phần móng.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 21.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9c3c8fe182fcef0e869cd075619e10b217b7cf9ae4f84abe74f21a5a358cebed8/2-6857.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 21.\"/>\n</div>\n<figcaption>\n<p>\n   Trong đó, dự án Khu dân cư Hòa Lân nằm ở mặt tiền quốc lộ 13 có quy mô 0,6 ha, cung cấp ra thị trường khoảng gần 700 căn hộ. Dự án này do Trí Holdings làm chủ đầu tư và Dicera Holdings phát triển.\n  </p>\n</figcaption>\n</figure>\n<p>\n ​\n</p>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 22.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a0671dae155ab7a35185927be70f3ebb524/tp-c_3-7440.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 22.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án Hồ Gươm Xanh của TBS Land cũng đang được thị trường bất động sản ngóng đợi.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 23.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06c76ae4e2cbddccb4d720e2b60a8dcd4e/tp-c_4-6175.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 23.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án có quy mô 26 ha, đặc biệt có hồ cảnh quan rộng 7 ha ở giữa dự án.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 24.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06fa6bc49660aeebe43ab03adc68465057/tp-c_5-3619.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 24.\"/>\n</div>\n<figcaption>\n<p>\n   Theo thông tin ban đầu, dự án có gần 5.000 căn cao tầng và gần 500 căn thấp tầng.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 25.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a062d3a69691d62470b4029776ae8334798/tp-c_6-231.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 25.\"/>\n</div>\n<figcaption>\n<p>\n   Bên trong dự án đang thi công tấp nập.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 26.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca92c6c62e76d5c3edf47d55a9c9871d9795884450711606de351006a472d25039c/12-3427.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 26.\"/>\n</div>\n<figcaption>\n<p>\n   Khải Hoàn Land cũng góp mặt ở quốc lộ 13 bằng dự án Khải Hoàn Imperial.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 27.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca92be6432fafc03faa0932e4a117c6a951e70bdff501ce587c0e2fc05d848ee290/11-5732.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 27.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án Khải Hoàn Imperial được quảng cáo là khu phức hợp căn hộ hạng sang chuẩn Bespoke (cá nhân hóa).\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 28.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9c50995d961a2b4303bd44f6e6cfe055fbc483897e3431d1a2ce622a52fe6a15c/10-4584.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 28.\"/>\n</div>\n<figcaption>\n<p>\n   Đáng chú ý, dù nằm ở Bình Dương cũ nhưng dự án này được chạy quảng cáo rầm rộ với giá bán lên tới 4.000 USD/m2.\n  </p>\n</figcaption>\n</figure>\n<p>\n ​\n</p>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 29.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06997af1f3ecd9dfdc2e24b60913111644/tp-c_17-858.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 29.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án Bcons New Sky (Khu căn hộ chung cư Điểm đến mới - The New Point) là tổ hợp căn hộ phân khúc cao cấp do Tập đoàn Bcons (pháp nhân phát triển là Công ty TNHH Song Hỷ Quốc Tế) đầu tư xây dựng tại mặt tiền quốc lộ 13.\n  </p>\n</figcaption>\n</figure>\n<figure>\n<div>\n<img alt=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 30.\" src=\"https://cdn.tienphong.vn/images/0b69b2bfe7bd891e9450796969567ca9385cd6e44f641394c5deee0150243a06729b61caba270f422adffdd2ad5b085a/tp-c_16-9590.jpg.avif\" title=\"Hàng chục dự án căn hộ đua nhau 'mọc' lên dọc đoạn Quốc lộ- Ảnh 30.\"/>\n</div>\n<figcaption>\n<p>\n   Dự án gồm 2 block cao 29 tầng và có 2 tầng hầm đỗ xe, cung ứng ra thị trường 1.632 căn hộ, 24 căn shophouse và văn phòng\n  </p>\n</figcaption>\n</figure>\n</div>\n</div></body></html>"}